# ---------------------------------------------------------------------------
# Environment template
# Copy this file to ".env" and adjust values locally.
# NEVER commit the real ".env" file.
# ---------------------------------------------------------------------------

# Flask runtime
FLASK_DEBUG=0
PORT=5000

# ---------------------------------------------------------------------------
# OPTIONAL language-model adapter (disabled by default)
# ---------------------------------------------------------------------------
# The default extraction engine is deterministic and rule-based and does NOT
# use these values. They are placeholders only, included to show how a future
# optional LLM adapter would be configured. If you enable such an adapter,
# validate the model response with validator.py before displaying it.
#
# LLM_ENABLED=0
# LLM_PROVIDER=openai-compatible
# LLM_API_KEY=replace-with-your-own-key
# LLM_MODEL=replace-with-model-name
